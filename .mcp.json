{
  "mcpServers": {
    "mcp-server-tempest": {
      "command": "uvx",
      "args": ["mcp-server-tempest==0.12.0"],
      "env": {
        "WEATHERFLOW_API_TOKEN": "${WEATHERFLOW_API_TOKEN}",
        "WEATHERFLOW_DISK_CACHE_TTL": "${WEATHERFLOW_DISK_CACHE_TTL:-86400}",
        "WEATHERFLOW_CACHE_TTL": "${WEATHERFLOW_CACHE_TTL:-300}",
        "WEATHERFLOW_CACHE_SIZE": "${WEATHERFLOW_CACHE_SIZE:-100}"
      }
    }
  }
}
